<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DailyReceipt</title>
  <link rel="stylesheet" href="/public/css/style.css" />
  <script src="/public/js/app.js"></script>
  <script src="/public/js/vendor/alpine.min.js" defer></script>
</head>
<body x-data="appShell()" @toast.window="onToast($event.detail)" class="min-h-screen bg-gray-50 dark:bg-gray-950 text-gray-900 dark:text-gray-100">
  <header class="border-b border-gray-200 dark:border-gray-800 bg-white/80 dark:bg-gray-900/80 backdrop-blur sticky top-0 z-10">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="font-semibold text-lg">DailyReceipt</span>
      </div>
      <nav class="flex gap-1">
        <a href="/printer" class="<%= active === 'printer' ? 'nav-link-active' : 'nav-link' %>">Imprimante</a>
        <a href="/schedule" class="<%= active === 'schedule' ? 'nav-link-active' : 'nav-link' %>">Planification</a>
        <a href="/builder" class="<%= active === 'builder' ? 'nav-link-active' : 'nav-link' %>">Constructeur</a>
      </nav>
    </div>
  </header>

  <main class="max-w-5xl mx-auto px-4 sm:px-6 py-8">
