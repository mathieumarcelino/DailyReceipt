  </main>

  <div
    x-show="toast"
    x-transition
    x-cloak
    class="fixed bottom-4 right-4 z-50 max-w-sm rounded-lg px-4 py-3 shadow-lg text-sm font-medium"
    :class="toast?.type === 'error' ? 'bg-red-600 text-white' : 'bg-emerald-600 text-white'"
    x-text="toast?.message"
  ></div>
</body>
</html>
