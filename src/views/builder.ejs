<%- include('partials/head', { active }) %>

<script src="/public/js/builder.js"></script>

<div x-data="builderPage()" x-init="init()">
  <h1 class="text-2xl font-bold mb-1">Constructeur de ticket</h1>
  <p class="text-gray-500 dark:text-gray-400 mb-6">Activez, ordonnez et configurez les modules affichés sur le ticket. L'aperçu à droite reflète le rendu réel sur papier.</p>

  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_auto] gap-6 items-start">
    <!-- Liste des modules -->
    <div class="space-y-3" x-show="!loading" x-cloak>
      <template x-for="(mod, index) in modules" :key="mod.id">
        <div class="card overflow-hidden">
          <div class="p-4 flex items-center gap-3">
            <div class="flex flex-col gap-0.5 shrink-0">
              <button type="button" class="btn-icon" :disabled="index === 0" @click="move(index, -1)" title="Monter">▲</button>
              <button type="button" class="btn-icon" :disabled="index === modules.length - 1" @click="move(index, 1)" title="Descendre">▼</button>
            </div>

            <div class="flex-1 min-w-0">
              <div class="font-semibold" x-text="mod.name"></div>
              <div class="text-sm text-gray-500 dark:text-gray-400 break-words" x-text="mod.description"></div>
              <div class="text-sm text-gray-400 dark:text-gray-500 break-words" x-show="mod.dataSource">
                Source des données :
                <a :href="'https://' + mod.dataSource" target="_blank" rel="noopener noreferrer" class="hover:text-accent-600" x-text="mod.dataSource"></a>
              </div>
            </div>

            <label class="flex items-center gap-2 cursor-pointer shrink-0">
              <input type="checkbox" x-model="mod.enabled" @change="setEnabled(mod)" class="sr-only peer" />
              <div class="w-11 h-6 rounded-full bg-gray-300 dark:bg-gray-700 peer-checked:bg-accent-600 relative transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-5 after:h-5 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:after:translate-x-5"></div>
            </label>

            <button type="button" class="btn-secondary shrink-0" @click="toggle(mod.id)" x-text="expandedId === mod.id ? 'Fermer' : 'Configurer'"></button>
          </div>

          <div class="border-t border-gray-200 dark:border-gray-800 p-4 bg-gray-50/50 dark:bg-gray-900/50" x-show="expandedId === mod.id" x-cloak x-transition>
            <template x-if="mod.configSchema.length === 0">
              <p class="text-sm text-gray-500 dark:text-gray-400">Ce module n'a aucun paramètre.</p>
            </template>

            <template x-for="field in mod.configSchema" :key="field.key">
              <div class="mb-4">
                <template x-if="field.type === 'text'">
                  <div>
                    <label class="field-label" x-text="field.label"></label>
                    <input type="text" class="field-input" x-model="mod.config[field.key]" :placeholder="field.placeholder || ''" />
                  </div>
                </template>

                <template x-if="field.type === 'password'">
                  <div x-data="{ showPw: false }">
                    <label class="field-label" x-text="field.label"></label>
                    <div class="relative">
                      <input
                        :type="showPw ? 'text' : 'password'"
                        class="field-input pr-16"
                        x-model="mod.config[field.key]"
                        :placeholder="field.placeholder || ''"
                        autocomplete="off"
                      />
                      <button
                        type="button"
                        class="absolute inset-y-0 right-2 text-xs text-gray-500 dark:text-gray-400 hover:text-gray-800 dark:hover:text-gray-200"
                        @click="showPw = !showPw"
                        x-text="showPw ? 'Masquer' : 'Afficher'"
                      ></button>
                    </div>
                  </div>
                </template>

                <template x-if="field.type === 'number'">
                  <div>
                    <label class="field-label" x-text="field.label"></label>
                    <input type="number" class="field-input" x-model.number="mod.config[field.key]" :step="field.step || 1" />
                  </div>
                </template>

                <template x-if="field.type === 'boolean'">
                  <label class="flex items-center gap-3 cursor-pointer w-fit">
                    <input type="checkbox" x-model="mod.config[field.key]" class="sr-only peer" />
                    <div class="w-11 h-6 rounded-full bg-gray-300 dark:bg-gray-700 peer-checked:bg-accent-600 relative transition-colors after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-5 after:h-5 after:rounded-full after:bg-white after:shadow after:transition-transform peer-checked:after:translate-x-5"></div>
                    <span class="text-sm font-medium" x-text="field.label"></span>
                  </label>
                </template>

                <template x-if="field.type === 'select'">
                  <div>
                    <label class="field-label" x-text="field.label"></label>
                    <select class="field-input" x-model="mod.config[field.key]">
                      <template x-for="opt in field.options" :key="opt.value">
                        <option :value="opt.value" x-text="opt.label"></option>
                      </template>
                    </select>
                  </div>
                </template>

                <template x-if="field.type === 'image'">
                  <div>
                    <label class="field-label" x-text="field.label"></label>
                    <div class="flex items-center gap-3">
                      <div class="w-24 h-16 rounded-lg border border-dashed border-gray-300 dark:border-gray-700 bg-white flex items-center justify-center overflow-hidden shrink-0">
                        <img x-show="mod.config[field.key]" :src="mod.config[field.key]" class="max-w-full max-h-full object-contain" />
                        <span x-show="!mod.config[field.key]" class="text-[10px] text-gray-400 text-center px-1">Aucun logo</span>
                      </div>
                      <div class="flex flex-col gap-2">
                        <label class="btn-secondary !py-1 !px-3 text-xs cursor-pointer w-fit">
                          Choisir un PNG
                          <input type="file" accept="image/png" class="hidden" @change="onImageSelected(mod, field, $event)" />
                        </label>
                        <button type="button" class="text-xs text-red-600 dark:text-red-400 hover:underline w-fit" x-show="mod.config[field.key]" @click="removeImage(mod, field)">Retirer le logo</button>
                      </div>
                    </div>
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1">PNG uniquement, 500 Ko max. Redimensionné et tramé en noir/blanc automatiquement pour l'impression.</p>
                  </div>
                </template>

                <template x-if="field.type === 'array'">
                  <div>
                    <div class="flex items-center justify-between mb-2">
                      <span class="field-label mb-0" x-text="field.label"></span>
                      <button type="button" class="btn-secondary !py-1 !px-2 text-xs" @click="addArrayItem(mod, field)">+ Ajouter</button>
                    </div>

                    <div class="space-y-2">
                      <template x-for="(item, idx) in (mod.config[field.key] || [])" :key="idx">
                        <div class="flex items-end gap-2 p-3 rounded-lg bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700">
                          <div class="grid grid-cols-1 sm:grid-cols-3 gap-2 flex-1">
                            <template x-for="subField in field.itemSchema" :key="subField.key">
                              <div :class="(subField.type === 'team-search' || subField.type === 'stock-search' || subField.type === 'crypto-search') ? 'sm:col-span-3' : ''">
                                <label class="text-xs text-gray-500 dark:text-gray-400 block mb-1" x-text="subField.label"></label>

                                <template x-if="subField.type === 'team-search'">
                                  <div x-data="teamSearchState(item)">
                                    <template x-if="item[subField.key]">
                                      <div class="flex items-center gap-2 p-2 rounded-lg bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700">
                                        <img x-show="item[subField.key].badge" :src="item[subField.key].badge" class="w-8 h-8 object-contain shrink-0" />
                                        <div class="flex-1 min-w-0">
                                          <div class="text-sm font-medium truncate" x-text="item[subField.key].name"></div>
                                          <div class="text-xs text-gray-500 dark:text-gray-400 truncate" x-text="`${item[subField.key].sport} — ${item[subField.key].league}`"></div>
                                        </div>
                                        <button type="button" class="text-xs text-accent-600 hover:underline shrink-0" @click="item[subField.key] = null; query = '';">Changer</button>
                                      </div>
                                    </template>

                                    <template x-if="!item[subField.key]">
                                      <div>
                                        <div class="flex gap-2">
                                          <input
                                            type="text"
                                            class="field-input"
                                            x-model="query"
                                            placeholder="Nom de l'équipe (ex: Paris Saint-Germain)"
                                            @keydown.enter.prevent="search()"
                                          />
                                          <button type="button" class="btn-secondary !px-3 text-xs shrink-0" :disabled="loading || !query.trim()" @click="search()">
                                            <span x-show="!loading">Rechercher</span>
                                            <span x-show="loading" x-cloak>...</span>
                                          </button>
                                        </div>

                                        <div class="mt-2 space-y-1" x-show="results.length" x-cloak>
                                          <template x-for="candidate in results" :key="candidate.teamId + candidate.sport">
                                            <button
                                              type="button"
                                              class="w-full flex items-center gap-2 p-2 rounded-lg bg-emerald-50 dark:bg-emerald-950 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900 text-left"
                                              @click="choose(item, candidate)"
                                            >
                                              <img x-show="candidate.badge" :src="candidate.badge" class="w-8 h-8 object-contain shrink-0" />
                                              <div class="flex-1 min-w-0 text-sm">
                                                <span x-text="candidate.name"></span>
                                                <span class="text-xs text-gray-500 dark:text-gray-400" x-text="' (' + candidate.sport + ' — ' + candidate.league + ')'"></span>
                                              </div>
                                              <span class="text-xs text-accent-600 shrink-0">Choisir</span>
                                            </button>
                                          </template>
                                        </div>

                                        <p class="text-xs text-red-600 dark:text-red-400 mt-1" x-show="error" x-text="error"></p>
                                      </div>
                                    </template>
                                  </div>
                                </template>

                                <template x-if="subField.type === 'stock-search'">
                                  <div x-data="stockSearchState(item)">
                                    <template x-if="item[subField.key]">
                                      <div class="flex items-center gap-2 p-2 rounded-lg bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700">
                                        <div class="flex-1 min-w-0">
                                          <div class="text-sm font-medium truncate" x-text="item[subField.key].name"></div>
                                          <div class="text-xs text-gray-500 dark:text-gray-400 truncate" x-text="`${item[subField.key].symbol} — ${item[subField.key].exchange}`"></div>
                                        </div>
                                        <button type="button" class="text-xs text-accent-600 hover:underline shrink-0" @click="item[subField.key] = null; query = '';">Changer</button>
                                      </div>
                                    </template>

                                    <template x-if="!item[subField.key]">
                                      <div>
                                        <div class="flex gap-2">
                                          <input
                                            type="text"
                                            class="field-input"
                                            x-model="query"
                                            placeholder="Nom ou symbole (ex: Apple, AAPL)"
                                            @keydown.enter.prevent="search()"
                                          />
                                          <button type="button" class="btn-secondary !px-3 text-xs shrink-0" :disabled="loading || !query.trim()" @click="search()">
                                            <span x-show="!loading">Rechercher</span>
                                            <span x-show="loading" x-cloak>...</span>
                                          </button>
                                        </div>

                                        <div class="mt-2 space-y-1" x-show="results.length" x-cloak>
                                          <template x-for="candidate in results" :key="candidate.symbol">
                                            <button
                                              type="button"
                                              class="w-full flex items-center gap-2 p-2 rounded-lg bg-emerald-50 dark:bg-emerald-950 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900 text-left"
                                              @click="choose(item, candidate)"
                                            >
                                              <div class="flex-1 min-w-0 text-sm">
                                                <span x-text="candidate.name"></span>
                                                <span class="text-xs text-gray-500 dark:text-gray-400" x-text="' (' + candidate.symbol + ' — ' + candidate.exchange + ')'"></span>
                                              </div>
                                              <span class="text-xs text-accent-600 shrink-0">Choisir</span>
                                            </button>
                                          </template>
                                        </div>

                                        <p class="text-xs text-red-600 dark:text-red-400 mt-1" x-show="error" x-text="error"></p>
                                      </div>
                                    </template>
                                  </div>
                                </template>

                                <template x-if="subField.type === 'crypto-search'">
                                  <div x-data="cryptoSearchState(item)">
                                    <template x-if="item[subField.key]">
                                      <div class="flex items-center gap-2 p-2 rounded-lg bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-700">
                                        <div class="flex-1 min-w-0">
                                          <div class="text-sm font-medium truncate" x-text="item[subField.key].name"></div>
                                          <div
                                            class="text-xs text-gray-500 dark:text-gray-400 truncate"
                                            x-text="item[subField.key].rank ? `${item[subField.key].symbol} — #${item[subField.key].rank}` : item[subField.key].symbol"
                                          ></div>
                                        </div>
                                        <button type="button" class="text-xs text-accent-600 hover:underline shrink-0" @click="item[subField.key] = null; query = '';">Changer</button>
                                      </div>
                                    </template>

                                    <template x-if="!item[subField.key]">
                                      <div>
                                        <div class="flex gap-2">
                                          <input
                                            type="text"
                                            class="field-input"
                                            x-model="query"
                                            placeholder="Nom ou symbole (ex: Bitcoin, BTC)"
                                            @keydown.enter.prevent="search()"
                                          />
                                          <button type="button" class="btn-secondary !px-3 text-xs shrink-0" :disabled="loading || !query.trim()" @click="search()">
                                            <span x-show="!loading">Rechercher</span>
                                            <span x-show="loading" x-cloak>...</span>
                                          </button>
                                        </div>

                                        <div class="mt-2 space-y-1" x-show="results.length" x-cloak>
                                          <template x-for="candidate in results" :key="candidate.id">
                                            <button
                                              type="button"
                                              class="w-full flex items-center gap-2 p-2 rounded-lg bg-emerald-50 dark:bg-emerald-950 border border-emerald-200 dark:border-emerald-800 hover:bg-emerald-100 dark:hover:bg-emerald-900 text-left"
                                              @click="choose(item, candidate)"
                                            >
                                              <div class="flex-1 min-w-0 text-sm">
                                                <span x-text="candidate.name"></span>
                                                <span
                                                  class="text-xs text-gray-500 dark:text-gray-400"
                                                  x-text="candidate.rank ? ' (' + candidate.symbol + ' — #' + candidate.rank + ')' : ' (' + candidate.symbol + ')'"
                                                ></span>
                                              </div>
                                              <span class="text-xs text-accent-600 shrink-0">Choisir</span>
                                            </button>
                                          </template>
                                        </div>

                                        <p class="text-xs text-red-600 dark:text-red-400 mt-1" x-show="error" x-text="error"></p>
                                      </div>
                                    </template>
                                  </div>
                                </template>

                                <template x-if="subField.type === 'select'">
                                  <select class="field-input" x-model="item[subField.key]">
                                    <template x-for="opt in subField.options" :key="opt.value">
                                      <option :value="opt.value" x-text="opt.label"></option>
                                    </template>
                                  </select>
                                </template>

                                <template x-if="subField.type === 'text'">
                                  <input type="text" class="field-input" x-model="item[subField.key]" :placeholder="subField.placeholder || ''" />
                                </template>

                                <template x-if="subField.type === 'number'">
                                  <input type="number" class="field-input" x-model.number="item[subField.key]" />
                                </template>

                                <template x-if="subField.type === 'boolean'">
                                  <input type="checkbox" x-model="item[subField.key]" class="h-5 w-5 rounded border-gray-300" />
                                </template>
                              </div>
                            </template>
                          </div>
                          <button type="button" class="btn-icon" @click="removeArrayItem(mod, field, idx)" title="Supprimer">✕</button>
                        </div>
                      </template>

                      <p class="text-xs text-gray-400" x-show="!(mod.config[field.key] || []).length">Aucun élément. Cliquez sur "+ Ajouter".</p>
                    </div>
                  </div>
                </template>

                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" x-show="field.help" x-text="field.help"></p>
              </div>
            </template>

            <div class="pt-2">
              <button type="button" class="btn-primary" :disabled="savingId === mod.id" @click="saveConfig(mod)">
                <span x-show="savingId !== mod.id">Enregistrer la configuration</span>
                <span x-show="savingId === mod.id" x-cloak>Enregistrement...</span>
              </button>
            </div>
          </div>
        </div>
      </template>
    </div>

    <div x-show="loading" class="text-gray-500">Chargement...</div>

    <!-- Aperçu -->
    <div class="lg:sticky lg:top-20">
      <div class="flex items-center justify-between mb-3">
        <h2 class="font-semibold">Aperçu du ticket</h2>
        <button type="button" class="btn-secondary !py-1 !px-3 text-xs" :disabled="previewLoading" @click="loadPreview()">
          <span x-show="!previewLoading">Rafraîchir</span>
          <span x-show="previewLoading" x-cloak>...</span>
        </button>
      </div>

      <div class="bg-white text-black rounded-lg shadow-lg mx-auto p-4 font-mono text-[12px] overflow-x-auto" :style="`width: calc(${preview.columns || 48}ch + 2rem); min-height: 200px;`">
        <template x-for="(line, i) in preview.lines" :key="i">
          <div>
            <template x-if="line.type === 'image'">
              <div class="py-1" :class="line.align === 'center' ? 'text-center' : line.align === 'right' ? 'text-right' : 'text-left'">
                <img :src="line.image.previewPngDataUrl" class="max-w-full h-auto inline-block" alt="Logo du ticket" />
              </div>
            </template>
            <template x-if="line.type !== 'image'">
              <div
                class="whitespace-pre font-mono text-[12px] leading-[1.45]"
                :class="[
                  line.align === 'center' ? 'text-center' : line.align === 'right' ? 'text-right' : 'text-left',
                  line.bold ? 'font-bold' : '',
                  line.underline ? 'underline' : '',
                  (line.size === 'wide' || line.size === 'double') ? 'tracking-wider text-[13px]' : '',
                  (line.size === 'tall' || line.size === 'double') ? 'text-[15px] leading-[1.7]' : '',
                ]"
                x-text="line.type === 'blank' ? ' ' : line.text"
              ></div>
            </template>
          </div>
        </template>
        <p class="text-gray-400 text-xs text-center py-6" x-show="!preview.lines.length">Aucun module actif.</p>
      </div>
    </div>
  </div>
</div>

<%- include('partials/foot') %>
