{
  "name": "dailyreceipt",
  "version": "1.0.0",
  "description": "Ticket de caisse quotidien auto-hébergé (météo, anniversaires, bourse...) imprimé sur imprimante thermique ESC/POS réseau.",
  "private": true,
  "license": "MIT",
  "main": "dist/server.js",
  "scripts": {
    "dev:server": "tsx watch src/server.ts",
    "dev:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/style.css --watch",
    "dev": "concurrently -n server,css -c blue,magenta \"npm:dev:server\" \"npm:dev:css\"",
    "build:css": "tailwindcss -i ./src/public/css/input.css -o ./src/public/css/style.css --minify",
    "build:server": "tsc -p tsconfig.json",
    "build": "npm run build:css && npm run build:server && npm run copy:assets",
    "copy:assets": "node scripts/copy-assets.js",
    "postinstall": "node scripts/copy-vendor.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^8.0.3",
    "@fastify/view": "^10.0.1",
    "alpinejs": "^3.14.3",
    "ejs": "^3.1.10",
    "fastify": "^5.1.0",
    "iconv-lite": "^0.6.3",
    "node-cron": "^3.0.3",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/pngjs": "^6.0.5",
    "concurrently": "^9.1.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
